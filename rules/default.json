{
  "_about": "packtidy 规则包格式 v1",
  "_note": "这是格式示例。真实规则包由维护者发布到独立仓库，packtidy 用 rules sync 拉取。",
  "_schema": {
    "version": "整数，规则包版本。本地缓存据此判断是否需要更新",
    "minPacktidy": "最低兼容的 packtidy 版本，如 0.1.0",
    "updated": "ISO 日期",
    "protected": "受保护目录名。命中即整棵不动",
    "nestedAllow": "受保护区内仍可整理的子目录名",
    "nestedDeny": "即使父级被放行，这些也不能动（优先级最高）",
    "crossRules": "组名关键词 → 目标分类。按顺序匹配，先中先得",
    "newCategories": "允许新建的分类。每个含父级归属和触发关键词",
    "categoryNodes": "本身就是分类容器的顶层目录名，内部组默认不动"
  },

  "version": 1,
  "minPacktidy": "0.1.0",
  "updated": "2026-11-09",

  "protected": [
    "steamlibrary", "steamapps", "games", "my games",
    "epic games", "battle.net", "shaderpacks",
    "appdata", "program files", "program files (x86)",
    "programdata", "windows", "system32", "syswow64",
    "system volume information", "$recycle.bin",
    ".git", "node_modules", ".venv", "site-packages",
    "_organize"
  ],

  "nestedAllow": [
    "downloads", "download", "桌面", "desktop",
    "documents", "文档", "temp", "tmp", "缓存", "cache",
    "捕获", "captures", "screenshots", "screenshot",
    "截图", "录屏", "recordings", "output", "outputs", "导出",
    "_待删除", "_重复待确认", "_未归类"
  ],

  "nestedDeny": [
    "node_modules", ".git", "site-packages", "venv", ".venv",
    "steamapps", "appdata", "windows", "system32", "syswow64",
    "program files", "program files (x86)", "programdata",
    "$recycle.bin", "system volume information"
  ],

  "crossRules": [
    {"keys": ["番剧", "动画", "动漫"], "to": ["影视", "Video", "番"]},
    {"keys": ["电影", "影片", "剧集", "短剧", "MV", "录屏"], "to": ["影视", "Video"]},
    {"keys": ["教程", "课程", "网课", "科普", "讲座", "公开课"], "to": ["学习资料", "文档", "个人文档"]},
    {"keys": ["ASMR", "音声"], "to": ["ASMR"]},
    {"keys": ["galgame", "成人", "R18"], "to": ["H_Library"]},
    {"keys": ["安装包", "破解", "插件", "绿色版"], "to": ["软件安装包"]},
    {"keys": ["镜像", "刷机", "装机", "驱动"], "to": ["系统镜像"]},
    {"keys": ["模型", "工作流", "词库", "LoRA", "embedding", "ComfyUI", "训练"], "to": ["AI工具"]},
    {"keys": ["游戏", "Minecraft"], "to": ["游戏"]},
    {"keys": ["备份", "还原点"], "to": ["backup"]},
    {"keys": ["VOCALOID", "音源"], "to": ["VOCALOID"]},
    {"keys": ["漫画", "同人志"], "to": ["漫画", "Doujin"]}
  ],

  "newCategories": {
    "电子书":   {"parent": "文档",   "keys": ["电子书", "小说", "epub"]},
    "教材":     {"parent": "文档",   "keys": ["教材", "教科书", "课本"]},
    "课程":     {"parent": "文档",   "keys": ["课程", "网课", "培训"]},
    "字体":     {"parent": "文档",   "keys": ["字体", "字库", "font"]},
    "刷机":     {"parent": "系统",   "keys": ["刷机", "ROM", "TWRP", "OTA", "救砖"]},
    "驱动":     {"parent": "系统",   "keys": ["驱动", "driver"]},
    "系统镜像": {"parent": "系统",   "keys": ["iso", "gho", "wim"]},
    "素材":     {"parent": "设计",   "keys": ["素材", "笔刷", "预设"]},
    "壁纸":     {"parent": null,     "keys": ["壁纸", "wallpaper"]},
    "音效":     {"parent": null,     "keys": ["音效", "sound"]}
  },

  "categoryNodes": [
    "AI工具", "H_Library", "番", "VOCALOID", "影视", "游戏",
    "系统镜像", "软件安装包", "文档", "学习资料", "娱乐视频",
    "Adobe", "PPT模板", "代码", "漫画", "backup",
    "Media", "Doujin", "Documents", "Software"
  ],

  "_changelog": [
    {"version": 1, "date": "2026-11-09", "note": "初始格式。含保护清单、嵌套白名单、跨类映射。"}
  ]
}
